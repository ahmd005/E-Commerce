APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:4+FtGVMAksFY0mEq934M6TZJeTlqHf/EpERVO8Ve+oc=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# إعدادات السجلات (Logs)
# تم ضبطها على daily لتجنب تضخم حجم الملف وتعليق محرر الأكواد
LOG_CHANNEL=daily
LOG_LEVEL=debug

# إعدادات قاعدة البيانات
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=root
DB_PASSWORD=

# إعدادات الجلسات والكاش
# استخدام database لضمان استقرار الـ Locks أثناء اختبارات الأداء
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# CACHE_STORE=redis
# RATE_LIMITER_DRIVER=redis
RATE_LIMITER_DRIVER=database
# CACHE_PREFIX=
CACHE_PREFIX=laravel_app_


# إعدادات الطوابير (Queue) - RabbitMQ
# QUEUE_CONNECTION=rabbitmq

QUEUE_CONNECTION=database

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# إعدادات الملفات والبريد (Log Mode للبريد للتجربة)
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# إعدادات الخدمات الإضافية
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
# REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379







